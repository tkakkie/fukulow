diff --git a/src/pool/fk515.rs b/src/pool/fk515.rs
new file mode 100644
index 0000000..b5fbf73
--- /dev/null
+++ b/src/pool/fk515.rs
@@ -0,0 +1,141 @@
+// Diagnostic-only instrumentation for the #515 REST replay.
+use crossbeam_queue::SegQueue;
+use std::{
+    future::Future,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, AtomicUsize, Ordering::Relaxed},
+    },
+    time::Instant,
+};
+
+pub type Event = (&'static str, Option<usize>, u64, u64);
+type Emit = Box<dyn FnOnce(Vec<Event>) + Send>;
+
+#[derive(Clone)]
+pub struct Trace(Arc<State>);
+
+struct State {
+    start: Instant,
+    acquired: AtomicUsize,
+    success: AtomicBool,
+    // Lock-free: a descheduled writer can never block the request worker.
+    events: SegQueue<Event>,
+    emit: Mutex<Option<Emit>>,
+}
+
+#[cfg(feature = "_rt-tokio")]
+tokio::task_local! { static TRACE: Trace; static SQL: (); }
+
+#[cfg(feature = "_rt-tokio")]
+pub async fn scope<T>(trace: Trace, future: impl Future<Output = T>) -> T {
+    TRACE.scope(trace, future).await
+}
+
+pub(super) fn current() -> Option<Trace> {
+    #[cfg(feature = "_rt-tokio")]
+    return TRACE.try_with(Clone::clone).ok();
+    #[cfg(not(feature = "_rt-tokio"))]
+    None
+}
+
+impl Trace {
+    pub fn new(emit: impl FnOnce(Vec<Event>) + Send + 'static) -> Self {
+        Self(Arc::new(State {
+            start: Instant::now(),
+            acquired: AtomicUsize::new(0),
+            success: AtomicBool::new(false),
+            events: SegQueue::new(),
+            emit: Mutex::new(Some(Box::new(emit))),
+        }))
+    }
+
+    pub(super) fn acquire_index(&self) -> usize {
+        self.0.acquired.fetch_add(1, Relaxed)
+    }
+
+    pub fn success(&self) {
+        self.0.success.store(true, Relaxed);
+    }
+
+    pub fn span(&self, label: &'static str, index: Option<usize>) -> Span {
+        Span {
+            trace: self.clone(),
+            label,
+            index,
+            start: self.ns(),
+        }
+    }
+
+    pub(super) fn record(&self, event: Event) {
+        self.0.events.push(event);
+    }
+
+    pub(super) fn ns(&self) -> u64 {
+        self.0.start.elapsed().as_nanos() as u64
+    }
+}
+
+impl Drop for State {
+    fn drop(&mut self) {
+        // Last owner may be an asynchronous SQLx return. Keep one log per
+        // request without waiting for a return on the HTTP path.
+        if self.success.load(Relaxed) {
+            if let Ok(Some(emit)) = self.emit.get_mut().map(Option::take) {
+                let mut events = Vec::with_capacity(self.events.len());
+                while let Some(event) = self.events.pop() {
+                    events.push(event);
+                }
+                emit(events);
+            }
+        }
+    }
+}
+
+pub struct Span {
+    trace: Trace,
+    label: &'static str,
+    index: Option<usize>,
+    start: u64,
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        let end = self.trace.ns();
+        self.trace.record((self.label, self.index, self.start, end));
+    }
+}
+
+pub fn span(label: &'static str) -> Option<Span> {
+    current().map(|trace| trace.span(label, None))
+}
+
+pub async fn observe<T>(label: &'static str, future: impl Future<Output = T>) -> T {
+    let _span = span(label);
+    future.await
+}
+
+pub fn measure<T>(label: &'static str, f: impl FnOnce() -> T) -> T {
+    let _span = span(label);
+    f()
+}
+
+#[cfg(feature = "_rt-tokio")]
+pub async fn query<T>(label: &'static str, future: impl Future<Output = T>) -> T {
+    SQL.scope((), observe(label, future)).await
+}
+
+pub fn sql_span(label: &'static str) -> Option<Span> {
+    #[cfg(feature = "_rt-tokio")]
+    return SQL.try_with(|()| span(label)).ok().flatten();
+    #[cfg(not(feature = "_rt-tokio"))]
+    {
+        let _ = label;
+        None
+    }
+}
+
+pub fn sql_measure<T>(label: &'static str, f: impl FnOnce() -> T) -> T {
+    let _span = sql_span(label);
+    f()
+}
