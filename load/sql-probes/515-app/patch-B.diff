diff --git a/server/src/fk515.rs b/server/src/fk515.rs
new file mode 100644
index 0000000..a66dc67
--- /dev/null
+++ b/server/src/fk515.rs
@@ -0,0 +1,93 @@
+use std::{
+    fs::OpenOptions,
+    io::Write,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering::Relaxed},
+        mpsc::{RecvTimeoutError, SyncSender, sync_channel},
+    },
+    time::Duration,
+};
+
+use axum::{
+    extract::{Request, State},
+    http::Method,
+    middleware::Next,
+    response::Response,
+};
+use sqlx::pool::fk515::{Event, Trace, scope};
+
+#[derive(Clone)]
+pub struct TraceSink {
+    sender: SyncSender<(u64, Vec<Event>)>,
+    dropped: Arc<AtomicUsize>,
+}
+
+impl TraceSink {
+    pub fn start() -> Self {
+        let (sender, receiver) = sync_channel::<(u64, Vec<Event>)>(128);
+        let dropped = Arc::new(AtomicUsize::new(0));
+        let count = dropped.clone();
+        let _ = std::thread::Builder::new()
+            .name("fk515-traces".into())
+            .spawn(move || {
+                let Ok(mut output) = OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .open("/tmp/fk515-app-traces.log")
+                else {
+                    return;
+                };
+                let mut reported = 0;
+                loop {
+                    let next = receiver.recv_timeout(Duration::from_millis(200));
+                    if let Ok(trace) = &next {
+                        let written = serde_json::to_string(trace)
+                            .is_ok_and(|json| writeln!(output, "FK515_APP {json}").is_ok());
+                        if !written {
+                            count.fetch_add(1, Relaxed);
+                        }
+                    }
+                    // A full queue produces no message to wake an idle receiver.
+                    let lost = count.load(Relaxed);
+                    if lost != reported && writeln!(output, "FK515_APP_DROPPED {lost}").is_ok() {
+                        reported = lost;
+                    }
+                    if matches!(next, Err(RecvTimeoutError::Disconnected)) {
+                        break;
+                    }
+                }
+            });
+        Self { sender, dropped }
+    }
+}
+
+pub async fn request(State(sink): State<TraceSink>, req: Request, next: Next) -> Response {
+    let id = req
+        .headers()
+        .get("x-fk515-sample")
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.parse::<u64>().ok());
+    let Some(id) = id.filter(|_| {
+        req.method() == Method::GET
+            && req.uri().query().is_some_and(|query| {
+                query
+                    .split('&')
+                    .any(|param| param.starts_with("after_seq="))
+            })
+    }) else {
+        return next.run(req).await;
+    };
+    let trace = Trace::new(move |spans| {
+        if sink.sender.try_send((id, spans)).is_err() {
+            sink.dropped.fetch_add(1, Relaxed);
+        }
+    });
+    let timer = trace.span("request", None);
+    let response = scope(trace.clone(), next.run(req)).await;
+    drop(timer);
+    if response.status().is_success() {
+        trace.success();
+    }
+    response
+}
