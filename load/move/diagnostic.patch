+++ b/server/src/move_diagnostic.rs
@@ -0,0 +1,101 @@
+use axum::response::Response;
+use std::{
+    future::Future,
+    sync::{
+        Arc, OnceLock,
+        atomic::{AtomicU64, Ordering::Relaxed},
+    },
+    time::Instant,
+};
+
+tokio::task_local! {
+    static WRITE: Write;
+}
+
+static SEND_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Clone)]
+struct Write {
+    lane: &'static str,
+    started: Instant,
+    sampled: bool,
+    reason: Arc<OnceLock<&'static str>>,
+}
+
+pub(crate) async fn request(
+    lane: &'static str,
+    future: impl Future<Output = Response>,
+) -> Response {
+    let write = Write {
+        lane,
+        started: Instant::now(),
+        sampled: lane == "move" || SEND_SEQUENCE.fetch_add(1, Relaxed) % 32 == 0,
+        reason: Arc::default(),
+    };
+    let reason = write.reason.clone();
+    let response = WRITE.scope(write, future).await;
+    if response.status() == axum::http::StatusCode::SERVICE_UNAVAILABLE {
+        let reason = reason.get().copied().unwrap_or("unclassified");
+        tracing::info!(target: "fukulow", event = "move_diag_503", lane, reason);
+    }
+    response
+}
+
+pub(crate) fn inherit<F: Future>(future: F) -> impl Future<Output = F::Output> {
+    let write = WRITE.try_with(Clone::clone).ok();
+    async move {
+        match write {
+            Some(write) => WRITE.scope(write, future).await,
+            None => future.await,
+        }
+    }
+}
+
+pub(crate) fn rejection(reason: &'static str) {
+    let _ = WRITE.try_with(|write| write.reason.set(reason));
+}
+
+pub(crate) fn before_admission() {
+    let _ = WRITE.try_with(|write| {
+        if write.sampled {
+            record(write.lane, "before_admission", write.started, false);
+        }
+    });
+}
+
+pub(crate) async fn timed<T>(phase: &'static str, future: impl Future<Output = T>) -> T {
+    let mut timer = WRITE
+        .try_with(|write| {
+            write.sampled.then(|| Timer {
+                lane: write.lane,
+                phase,
+                started: Instant::now(),
+                interrupted: true,
+            })
+        })
+        .ok()
+        .flatten();
+    let result = future.await;
+    if let Some(timer) = &mut timer {
+        timer.interrupted = false;
+    }
+    result
+}
+
+struct Timer {
+    lane: &'static str,
+    phase: &'static str,
+    started: Instant,
+    interrupted: bool,
+}
+
+impl Drop for Timer {
+    fn drop(&mut self) {
+        record(self.lane, self.phase, self.started, self.interrupted);
+    }
+}
+
+fn record(lane: &'static str, phase: &'static str, started: Instant, interrupted: bool) {
+    tracing::info!(target: "fukulow", event = "move_diag_timing", lane, phase,
+        us = started.elapsed().as_secs_f64() * 1_000_000.0, interrupted);
+}
