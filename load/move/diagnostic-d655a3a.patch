diff --git a/server/src/move_diagnostic.rs b/server/src/move_diagnostic.rs
new file mode 100644
index 00000000..20d88d6c
--- /dev/null
+++ b/server/src/move_diagnostic.rs
@@ -0,0 +1,236 @@
+use axum::response::Response;
+use std::{
+    cell::Cell,
+    future::Future,
+    sync::{
+        Arc, OnceLock,
+        atomic::{AtomicU64, Ordering::Relaxed},
+    },
+    time::Instant,
+};
+use uuid::Uuid;
+
+tokio::task_local! {
+    static WRITE: Write;
+    static SEND_CHILDREN: Cell<u32>;
+}
+
+static SEND_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+static CHANNELS_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+static TOPICS_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+static READ_EVERY: OnceLock<Option<u64>> = OnceLock::new();
+
+// The harness sets the Part D read interval; without a valid one no read is sampled,
+// which the harness reports as missing read timings.
+fn read_every() -> Option<u64> {
+    *READ_EVERY.get_or_init(|| {
+        let every = std::env::var("FUKULOW_MOVE_DIAG_READ_EVERY")
+            .ok()
+            .and_then(|value| value.parse::<u64>().ok())
+            .filter(|every| (1..=1024).contains(every));
+        if every.is_none() {
+            tracing::warn!(target: "fukulow", event = "move_diag_read_every_invalid");
+        }
+        every
+    })
+}
+
+// Move always, sends 1 in 32, Part D reads 1 in FUKULOW_MOVE_DIAG_READ_EVERY.
+fn sample(lane: &'static str) -> (bool, Option<u64>) {
+    let (sequence, every) = match lane {
+        "move" => return (true, None),
+        "send" => {
+            let sequence = SEND_SEQUENCE.fetch_add(1, Relaxed);
+            return (sequence % 32 == 0, Some(sequence));
+        }
+        "channels" => (&CHANNELS_SEQUENCE, read_every()),
+        _ => (&TOPICS_SEQUENCE, read_every()),
+    };
+    (
+        every.is_some_and(|every| sequence.fetch_add(1, Relaxed) % every == 0),
+        None,
+    )
+}
+
+#[derive(Clone)]
+struct Write {
+    lane: &'static str,
+    // Set for the Channel-list route only: two workloads share it in separate Organizations.
+    organization: Option<Uuid>,
+    started: Instant,
+    sampled: bool,
+    request_id: Option<u64>,
+    reason: Arc<OnceLock<&'static str>>,
+}
+
+pub(crate) async fn request(
+    lane: &'static str,
+    organization: Option<Uuid>,
+    future: impl Future<Output = Response>,
+) -> Response {
+    let started = Instant::now();
+    let (sampled, request_id) = sample(lane);
+    let write = Write {
+        lane,
+        organization,
+        started,
+        sampled,
+        request_id,
+        reason: Arc::default(),
+    };
+    let reason = write.reason.clone();
+    let response = WRITE.scope(write, future).await;
+    if response.status() == axum::http::StatusCode::SERVICE_UNAVAILABLE {
+        let reason = reason.get().copied().unwrap_or("unclassified");
+        let organization = organization.map(|id| id.to_string()).unwrap_or_default();
+        tracing::info!(target: "fukulow", event = "move_diag_503", lane, organization, reason);
+    }
+    response
+}
+
+pub(crate) fn inherit<F: Future>(future: F) -> impl Future<Output = F::Output> {
+    let write = WRITE.try_with(Clone::clone).ok();
+    async move {
+        match write {
+            Some(write) => WRITE.scope(write, future).await,
+            None => future.await,
+        }
+    }
+}
+
+pub(crate) fn rejection(reason: &'static str) {
+    let _ = WRITE.try_with(|write| write.reason.set(reason));
+}
+
+pub(crate) fn before_admission() {
+    let _ = WRITE.try_with(|write| {
+        if write.sampled {
+            record(
+                write.lane,
+                write.organization,
+                "before_admission",
+                write.started,
+                false,
+                None,
+                None,
+            );
+        }
+    });
+}
+
+pub(crate) async fn timed<T>(phase: &'static str, future: impl Future<Output = T>) -> T {
+    let mut timer = Timer::start(phase);
+    let result = future.await;
+    if let Some(timer) = &mut timer {
+        timer.interrupted = false;
+    }
+    result
+}
+
+// Scope the send-only hooks to the sampled admitted future. In particular, the
+// canonical receipt snapshot can also run before admission.
+pub(crate) async fn send_admitted<T>(future: impl Future<Output = T>) -> T {
+    if WRITE.try_with(|write| write.sampled && write.request_id.is_some()) == Ok(true) {
+        SEND_CHILDREN
+            .scope(Cell::new(0), timed("admitted_work", future))
+            .await
+    } else {
+        timed("admitted_work", future).await
+    }
+}
+
+pub(crate) async fn send_timed<T>(phase: &'static str, future: impl Future<Output = T>) -> T {
+    if SEND_CHILDREN.try_with(|_| ()).is_ok() {
+        timed(phase, future).await
+    } else {
+        future.await
+    }
+}
+
+pub(crate) fn send_sync<T>(phase: &'static str, work: impl FnOnce() -> T) -> T {
+    let mut timer = SEND_CHILDREN
+        .try_with(|_| Timer::start(phase))
+        .ok()
+        .flatten();
+    let result = work();
+    if let Some(timer) = &mut timer {
+        timer.interrupted = false;
+    }
+    result
+}
+
+struct Timer {
+    lane: &'static str,
+    organization: Option<Uuid>,
+    phase: &'static str,
+    started: Instant,
+    interrupted: bool,
+    request_id: Option<u64>,
+}
+
+impl Timer {
+    fn start(phase: &'static str) -> Option<Self> {
+        WRITE
+            .try_with(|write| {
+                write.sampled.then(|| Self {
+                    lane: write.lane,
+                    organization: write.organization,
+                    phase,
+                    started: Instant::now(),
+                    interrupted: true,
+                    request_id: write
+                        .request_id
+                        .filter(|_| SEND_CHILDREN.try_with(|_| ()).is_ok()),
+                })
+            })
+            .ok()
+            .flatten()
+    }
+}
+
+impl Drop for Timer {
+    fn drop(&mut self) {
+        // A finished parent advertises how many records its executed path emitted,
+        // including nested access details. Pool timings are already covered by
+        // the write and receipt acquisition phases.
+        let send_children = self.request_id.and_then(|_| {
+            SEND_CHILDREN
+                .try_with(|children| {
+                    if self.phase == "admitted_work" {
+                        Some(children.get())
+                    } else {
+                        if self.phase != "pool_acquire" {
+                            children.set(children.get() + 1);
+                        }
+                        None
+                    }
+                })
+                .ok()
+                .flatten()
+        });
+        record(
+            self.lane,
+            self.organization,
+            self.phase,
+            self.started,
+            self.interrupted,
+            self.request_id,
+            send_children,
+        );
+    }
+}
+
+fn record(
+    lane: &'static str,
+    organization: Option<Uuid>,
+    phase: &'static str,
+    started: Instant,
+    interrupted: bool,
+    request_id: Option<u64>,
+    send_children: Option<u32>,
+) {
+    let organization = organization.map(|id| id.to_string()).unwrap_or_default();
+    tracing::info!(target: "fukulow", event = "move_diag_timing", lane, organization, phase,
+        us = started.elapsed().as_secs_f64() * 1_000_000.0, interrupted, request_id, send_children);
+}
