{
  "openapi": "3.1.0",
  "info": {
    "title": "fukulow-server",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/channels": {
      "get": {
        "tags": [
          "crate::channels"
        ],
        "summary": "List public channels of the caller's organization and private channels they belong to.",
        "operationId": "list_channels",
        "responses": {
          "200": {
            "description": "Public Channels and private Channels the Member belongs to in their Organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, ambiguous, expired, or revoked session credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database failure while resolving the session or listing visible Channels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "crate::channels"
        ],
        "summary": "Create a public or private channel with an organization-unique name.\nNames are compared with ASCII case folding; non-ASCII characters are unchanged.\nA private channel includes its creator as a member in the same transaction.",
        "operationId": "create_channel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created Channel; a private Channel includes its creator as a Member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Channel JSON or fields, name over 128 Unicode scalar values, or surrounding whitespace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, ambiguous, expired, or revoked session credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Channel name already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Channel creation request body exceeds the size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Channel creation requires an application/json content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database failure while resolving the session or creating the Channel and its membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/channels/{id}/messages": {
      "get": {
        "tags": [
          "crate::messages"
        ],
        "summary": "List visible channel messages using exclusive per-channel sequence cursors.\nafter_seq and before_seq are mutually exclusive; neither selects the latest page.\nPages are always ascending seq. Continue after_seq with the last seq, or before_seq\n(including older history from the latest page) with the first seq. has_more refers\nto that direction. limit defaults to 50 and is bounded to 1..=200; invalid queries\nreturn 400. Identity and organization come only from the authenticated session.",
        "operationId": "list_messages",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Channel id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after_seq",
            "in": "query",
            "description": "Return seq > after_seq; 0 starts at the beginning. Cannot combine with before_seq.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "before_seq",
            "in": "query",
            "description": "Return seq < before_seq. Cannot combine with after_seq.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, default 50, maximum 200.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of Channel Messages in ascending sequence order with directional has_more",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Channel id, sequence cursors, or page limit; after_seq and before_seq cannot be combined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, ambiguous, expired, or revoked session credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or is private and the caller is not a member; the response does not reveal whether the Channel exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database failure while resolving the session, checking Channel visibility, or listing Messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "crate::messages"
        ],
        "summary": "Send a message to a visible channel; topic_id is always null.\nThe session supplies organization and sender. A successful retry returns the same\ncanonical message with 201, allocating no new sequence and publishing no new event.\nA reused client_message_id with different body or channel returns 409.",
        "operationId": "send_message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Channel id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Confirmed Message; an idempotent retry returns the same Message and sequence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Channel id, Message JSON or fields, or body that is empty or whitespace-only, contains NUL, or exceeds 4000 Unicode scalar values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, ambiguous, expired, or revoked session credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Channel does not exist or is private and the caller is not a member; the response does not reveal whether the Channel exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Client message id reused with different body or channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Message send request body exceeds the size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Sending a Message requires an application/json content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database or worker failure while resolving the session, checking Channel visibility, or persisting the Message, including unknown COMMIT outcome or the 10 second database-work deadline; retry with the same client_message_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Send admission queue is full or the 30 second admission wait expired; persistence has not started; retry with the same client_message_id",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "Jittered retry delay in seconds (1 through 5)"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "crate"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is responding; returns the plain-text body ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "crate::auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Current session's Member and Organization identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, ambiguous, expired, or revoked session credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database failure while resolving the session identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/session": {
      "post": {
        "tags": [
          "crate::auth"
        ],
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; returns identity, session token and expiry, and sets the session cookie",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "HttpOnly; SameSite=Strict; Path=/; Secure by default"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sign-in JSON, fields, email or password length, or omitted Organization when no sole Organization exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Email or password does not match an account in the selected Organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed or in-flight sign-in attempts",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 1
                },
                "description": "Seconds until retry; at least 1"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database, password verification, or credential generation failure while signing in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "crate::auth"
        ],
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Session revoked and cookie cleared",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, ambiguous, expired, or revoked session credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database or worker failure while resolving or revoking the session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "crate::auth"
        ],
        "summary": "Report whether the first organization still needs to be created.\nAccessible without authentication or a setup token; reveals only setup_required.",
        "operationId": "setup_status",
        "responses": {
          "200": {
            "description": "Whether the first Organization still needs to be created",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          },
          "500": {
            "description": "Database failure while checking whether an Organization exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": []
      },
      "post": {
        "tags": [
          "crate::auth"
        ],
        "summary": "Create the first organization and Owner.",
        "description": "Body extraction precedes setup-token verification: malformed JSON or invalid field\ntypes return 400, oversized bodies return 413, and unsupported content types return\n415 even when the setup token is missing or invalid. After extraction, the token is\nchecked before semantic input validation, password hashing, or database access.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created the first Organization and Owner; returns their identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, fields, or input; body extraction precedes setup-token verification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid setup token after successful body extraction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Setup already completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database or password hashing failure while creating the first Organization and Owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ws": {
      "get": {
        "tags": [
          "crate::realtime"
        ],
        "summary": "Upgrade to WebSocket. ClientMessage and ServerEvent are the message schema roots.\nAuthenticate with the session cookie or Authorization: Bearer, never a query token.\nCookie auth requires a matching allowed Origin (configured, same-origin by default);\nreject a missing/foreign Origin with 403. Bearer clients need no Origin header.",
        "description": "On subscribe: first register the live subscription, queueing events per connection;\nreplay committed messages with seq > after_seq ascending in pages of up to 50\nmessages; flush queued live events with seq > last replayed;\nthen send subscribed with caught_up_seq. Clients dedupe by (channel_id, seq):\nduplicates are harmless, gaps are forbidden. Publish only committed new messages.\nQueue overflow closes with 4008 (never silently drops an event); reconnect and\nre-subscribe from the last seq per channel. Expiry/sign-out closes with 4001;\nstop protected delivery and go to Sign in.",
        "operationId": "upgrade",
        "responses": {
          "101": {
            "description": "WebSocket upgrade; frames use ClientMessage / ServerEvent"
          },
          "400": {
            "description": "Invalid WebSocket upgrade request after successful authentication and Origin validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, ambiguous, expired, or revoked session credential before WebSocket upgrade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Cookie Origin missing or not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Database failure while resolving the session before WebSocket upgrade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Channel": {
        "type": "object",
        "required": [
          "id",
          "name",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "At most 128 Unicode scalar values.",
            "maxLength": 128
          },
          "visibility": {
            "$ref": "#/components/schemas/ChannelVisibility"
          }
        }
      },
      "ChannelList": {
        "type": "object",
        "required": [
          "channels"
        ],
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Channel"
            }
          }
        }
      },
      "ChannelVisibility": {
        "type": "string",
        "enum": [
          "public",
          "private"
        ]
      },
      "ClientMessage": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Subscribe"
          },
          {
            "$ref": "#/components/schemas/Unsubscribe"
          }
        ],
        "description": "Client -> server control messages. Cursors are per channel and exclusive.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "subscribe": "#/components/schemas/Subscribe",
            "unsubscribe": "#/components/schemas/Unsubscribe"
          }
        }
      },
      "CreateChannelRequest": {
        "type": "object",
        "description": "Identity and organization come from the session, never from request fields.",
        "required": [
          "name",
          "visibility"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "At most 128 Unicode scalar values.\nLeading or trailing whitespace, as defined by Rust `str::trim()`, is rejected, not trimmed.\nInternal whitespace and empty names are allowed.",
            "maxLength": 128
          },
          "visibility": {
            "$ref": "#/components/schemas/ChannelVisibility"
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ErrorEvent": {
        "type": "object",
        "required": [
          "code",
          "type"
        ],
        "properties": {
          "channel_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": [
          "organization",
          "member"
        ],
        "properties": {
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          }
        }
      },
      "ListMessagesQuery": {
        "type": "object",
        "description": "Use after_seq XOR before_seq, or neither for the latest page. Cursors are exclusive.",
        "properties": {
          "after_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Return seq > after_seq; 0 starts at the beginning. Cannot combine with before_seq.",
            "minimum": 0
          },
          "before_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Return seq < before_seq. Cannot combine with after_seq.",
            "minimum": 1
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Page size, default 50, maximum 200.",
            "maximum": 200,
            "minimum": 1
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "channel_id",
          "seq",
          "client_message_id",
          "sender",
          "body",
          "created_at",
          "topic_id"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "channel_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_message_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sender": {
            "type": "string",
            "format": "uuid",
            "description": "Member id of the sender."
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "description": "Per-channel sequence, starting at 1.",
            "minimum": 1
          },
          "topic_id": {
            "type": "null"
          }
        }
      },
      "MessageEvent": {
        "type": "object",
        "description": "Live and replayed messages have exactly the same canonical shape.",
        "required": [
          "message",
          "type"
        ],
        "properties": {
          "message": {
            "$ref": "#/components/schemas/Message"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ]
          }
        }
      },
      "MessagePage": {
        "type": "object",
        "required": [
          "messages",
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean",
            "description": "More messages exist in the queried direction (older for latest/before_seq,\nnewer for after_seq). Continue after_seq with the last seq or before_seq\nwith the first seq; continue the latest page toward older messages with before_seq."
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "description": "Always ascending seq (newest last), including latest and before_seq pages."
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": [
          "organization_id",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "member",
          "guest"
        ]
      },
      "SendMessageRequest": {
        "type": "object",
        "description": "Idempotency key: (organization, sender, client_message_id), derived from the session.\nA retry with the same body and channel returns the same canonical message and sequence;\nreusing the key with a different body or channel returns 409.",
        "required": [
          "client_message_id",
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "description": "1..=4000 Unicode scalar values; no NUL or whitespace-only body. Stored without trimming.",
            "maxLength": 4000,
            "minLength": 1
          },
          "client_message_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ServerEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/MessageEvent"
          },
          {
            "$ref": "#/components/schemas/Subscribed"
          },
          {
            "$ref": "#/components/schemas/ErrorEvent"
          }
        ],
        "description": "Server -> client events. Clients dedupe messages by (channel_id, seq).",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "error": "#/components/schemas/ErrorEvent",
            "message": "#/components/schemas/MessageEvent",
            "subscribed": "#/components/schemas/Subscribed"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "identity",
          "token",
          "expires_in"
        ],
        "properties": {
          "expires_in": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "token": {
            "type": "string",
            "description": "Opaque bearer credential. Store securely; returned only on sign-in."
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "organization_name",
          "name",
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "organization_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "At least 12 characters, at most 1024 UTF-8 bytes.",
            "maxLength": 1024,
            "minLength": 12
          },
          "setup_token": {
            "type": [
              "string",
              "null"
            ],
            "format": "password",
            "description": "Required when FUKULOW_SETUP_TOKEN is configured on the server."
          }
        },
        "additionalProperties": false
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "setup_required"
        ],
        "properties": {
          "setup_required": {
            "type": "boolean"
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "organization_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Returned by setup; may be omitted only when exactly one organization exists."
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      },
      "Subscribe": {
        "type": "object",
        "required": [
          "channel_id",
          "after_seq",
          "type"
        ],
        "properties": {
          "after_seq": {
            "type": "integer",
            "format": "int64",
            "description": "Replay committed messages with seq > after_seq; 0 starts at the beginning.",
            "minimum": 0
          },
          "channel_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "subscribe"
            ]
          }
        }
      },
      "Subscribed": {
        "type": "object",
        "description": "Sent after committed replay and queued live events have been handed off.",
        "required": [
          "channel_id",
          "caught_up_seq",
          "type"
        ],
        "properties": {
          "caught_up_seq": {
            "type": "integer",
            "format": "int64",
            "description": "Last sequence caught up through; 0 when the channel has no messages.",
            "minimum": 0
          },
          "channel_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "subscribed"
            ]
          }
        }
      },
      "Unsubscribe": {
        "type": "object",
        "required": [
          "channel_id",
          "type"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "unsubscribe"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fukulow_session"
      }
    }
  }
}
