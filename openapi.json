{
  "openapi": "3.1.0",
  "info": {
    "title": "fukulow-server",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "crate"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "crate::auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/session": {
      "post": {
        "tags": [
          "crate::auth"
        ],
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "HttpOnly; SameSite=Strict; Path=/; Secure by default"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "crate::auth"
        ],
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Session revoked and cookie cleared",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/setup": {
      "post": {
        "tags": [
          "crate::auth"
        ],
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Setup already completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": [
          "organization",
          "member"
        ],
        "properties": {
          "member": {
            "$ref": "#/components/schemas/Member"
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "Organization": {
        "type": "object",
        "required": [
          "organization_id",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "member",
          "guest"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "identity",
          "token",
          "expires_in"
        ],
        "properties": {
          "expires_in": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "token": {
            "type": "string",
            "description": "Opaque bearer credential. Store securely; returned only on sign-in."
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "organization_name",
          "name",
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "organization_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "At least 12 characters, at most 1024 UTF-8 bytes.",
            "maxLength": 1024,
            "minLength": 12
          }
        },
        "additionalProperties": false
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "organization_id",
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "description": "Returned by setup; email addresses are unique within this organization."
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fukulow_session"
      }
    }
  }
}
