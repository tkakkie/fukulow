{
  "kind": "delivery",
  "scenarios": [
    {
      "id": "reply-chain-root-descendant-paging-retries-and-stream",
      "title": "A Reply inherits its Topic/root, paged chains include the root and siblings from any anchor, retries consume no log position, and live/replay preserve canonical records",
      "covers": [
        "P1",
        "P6",
        "P7",
        "S1",
        "S2",
        "S5"
      ],
      "rust": {
        "existing_tests": [
          "reply_chain_pages_root_and_all_descendants_from_every_anchor_with_concurrent_appends",
          "reply_ack_history_live_replay_shared_gap_and_unloaded_parent_payloads_match"
        ],
        "note": "No #139 proposed fixture existed on the #137 base; this server scenario runs now. Client panel behavior stays with #140."
      },
      "setup": {
        "organizations": [
          "o1"
        ],
        "members": [
          {
            "id": "alice",
            "organization": "o1"
          }
        ],
        "channels": [
          {
            "id": "general",
            "organization": "o1",
            "visibility": "public",
            "creator": "alice"
          }
        ]
      },
      "steps": [
        {
          "do": "post",
          "as": "alice",
          "channel": "general",
          "label": "root",
          "topic_name": "Release"
        },
        {
          "do": "connect",
          "socket": "s",
          "as": "alice"
        },
        {
          "do": "subscribe",
          "socket": "s",
          "channel": "general",
          "after_seq": 1
        },
        {
          "do": "expect",
          "socket": "s",
          "events": [
            {
              "type": "subscribed",
              "channel": "general",
              "caught_up_seq": 1
            }
          ]
        },
        {
          "do": "post",
          "as": "alice",
          "channel": "general"
        },
        {
          "do": "post",
          "as": "alice",
          "channel": "general",
          "label": "child",
          "reply_to": "root",
          "key": "retry"
        },
        {
          "do": "post",
          "as": "alice",
          "channel": "general",
          "label": "grandchild",
          "reply_to": "child"
        },
        {
          "do": "post",
          "as": "alice",
          "channel": "general",
          "label": "sibling",
          "reply_to": "root"
        },
        {
          "do": "expect",
          "socket": "s",
          "events": [
            {
              "type": "message",
              "channel": "general",
              "seqs": [
                2,
                3,
                4,
                5
              ]
            }
          ]
        },
        {
          "do": "reply_chain",
          "as": "alice",
          "channel": "general",
          "anchor": "root",
          "query": {
            "after_seq": 0,
            "limit": 2
          },
          "expect": {
            "status": 200,
            "root": "root",
            "seqs": [
              1,
              3
            ],
            "has_more": true
          }
        },
        {
          "do": "reply_chain",
          "as": "alice",
          "channel": "general",
          "anchor": "grandchild",
          "query": {
            "after_seq": 0,
            "limit": 2
          },
          "expect": {
            "status": 200,
            "root": "root",
            "seqs": [
              1,
              3
            ],
            "has_more": true
          }
        },
        {
          "do": "post",
          "as": "alice",
          "channel": "general",
          "reply_to": "child"
        },
        {
          "do": "expect",
          "socket": "s",
          "events": [
            {
              "type": "message",
              "channel": "general",
              "seqs": [
                6
              ]
            }
          ]
        },
        {
          "do": "reply_chain",
          "as": "alice",
          "channel": "general",
          "anchor": "sibling",
          "query": {
            "after_seq": 3,
            "limit": 2
          },
          "expect": {
            "status": 200,
            "root": "root",
            "seqs": [
              4,
              5
            ],
            "has_more": true
          }
        },
        {
          "do": "reply_chain",
          "as": "alice",
          "channel": "general",
          "anchor": "grandchild",
          "query": {
            "after_seq": 5,
            "limit": 2
          },
          "expect": {
            "status": 200,
            "root": "root",
            "seqs": [
              6
            ],
            "has_more": false
          }
        },
        {
          "do": "reply_chain",
          "as": "alice",
          "channel": "general",
          "anchor": "root",
          "query": {
            "after_seq": 6,
            "limit": 2
          },
          "expect": {
            "status": 200,
            "root": "root",
            "seqs": [],
            "has_more": false
          }
        },
        {
          "do": "post",
          "as": "alice",
          "channel": "general",
          "reply_to": "root",
          "key": "retry"
        },
        {
          "do": "expect",
          "socket": "s",
          "events": [
            {
              "type": "silent",
              "barrier": {
                "channel": "general",
                "caught_up_seq": 6
              }
            }
          ]
        },
        {
          "do": "close_socket",
          "socket": "s"
        },
        {
          "do": "connect",
          "socket": "r",
          "as": "alice"
        },
        {
          "do": "subscribe",
          "socket": "r",
          "channel": "general",
          "after_seq": 0
        },
        {
          "do": "expect",
          "socket": "r",
          "events": [
            {
              "type": "message",
              "channel": "general",
              "seqs": [
                {
                  "from": 1,
                  "to": 6
                }
              ]
            },
            {
              "type": "subscribed",
              "channel": "general",
              "caught_up_seq": 6
            }
          ]
        }
      ]
    }
  ]
}
