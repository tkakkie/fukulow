{
  "kind": "client",
  "scenarios": [
    {
      "id": "topic-messages-leave-holes-in-projections-without-false-gap",
      "title": "Topic Messages leave seq holes in the main timeline and in a Topic page, never a gap: the unfiltered stream moves the cursor, no fill is requested",
      "covers": ["P1","P2","C2","C3"],
      "proposed": {"owner": ["#138"]},
      "never": [{"type":"fetch_history","page":"after"},{"type":"wait","purpose":"reorder_grace"}],
      "steps": [
        {"input":{"type":"session_start"},"effects":{"required":[{"type":"connect"}]}},
        {"input":{"type":"connection_ready"}},
        {"input":{"type":"watch","channel":"A"},"effects":{"required":[{"type":"fetch_history","channel":"A","page":"latest","as":"f0"}]}},
        {"input":{"type":"history_result","respond_to":"f0","messages":[{"seq":1},{"seq":2,"topic":"T"},{"seq":3}],"has_more":false},"effects":{"required":[{"type":"subscribe","channel":"A","after_seq":3,"as":"s0"}]}},
        {"input":{"type":"subscribed","channel":"A","caught_up_seq":3,"respond_to":"s0"},"observe":{"channels":{"A":{"state":"ready","cursor":3}}}},
        {"input":{"type":"message","channel":"A","message":{"seq":4,"topic":"T"}},"observe":{"channels":{"A":{"cursor":4}}}},
        {"input":{"type":"message","channel":"A","message":{"seq":5}}},
        {"input":{"type":"message","channel":"A","message":{"seq":6,"topic":"T"}},"observe":{"channels":{"A":{"cursor":6}}}},
        {"input":{"type":"load_main_timeline","channel":"A"},"effects":{"required":[{"type":"fetch_main_timeline","channel":"A","as":"m0"}]}},
        {"input":{"type":"main_timeline_result","respond_to":"m0","as_of_seq":6,"items":[{"kind":"message","message":{"seq":1}},{"kind":"message","message":{"seq":3}},{"kind":"message","message":{"seq":5}},{"kind":"topic","topic":{"name":"T","last_seq":6,"message_count":3}}],"has_more":false},"effects":{"forbidden":[{"type":"fetch_history"},{"type":"subscribe"}]},"observe":{"channels":{"A":{"cursor":6,"main_timeline":[{"seq":1},{"seq":3},{"seq":5},{"topic":"T","position":6,"message_count":3}]}}},"note":"The main timeline skips 2, 4 and 6 (Topic Messages): not a gap."},
        {"input":{"type":"open_topic","channel":"A","topic":"T"},"effects":{"required":[{"type":"fetch_history","channel":"A","topic":"T","as":"t0"}]}},
        {"input":{"type":"history_result","respond_to":"t0","messages":[{"seq":2,"topic":"T"},{"seq":4,"topic":"T"},{"seq":6,"topic":"T"}],"has_more":false},"effects":{"forbidden":[{"type":"fetch_history"},{"type":"subscribe"}]},"observe":{"channels":{"A":{"cursor":6,"topics":{"T":{"visible":[2,4,6]}}}}},"note":"The Topic page skips 3 and 5 (Messages without Topic): not a gap."},
        {"input":{"type":"message","channel":"A","message":{"seq":7,"topic":"T"}},"observe":{"channels":{"A":{"cursor":7,"topics":{"T":{"visible":[2,4,6,7]}},"main_timeline":[{"seq":1},{"seq":3},{"seq":5},{"topic":"T","position":7,"message_count":4}]}}},"note":"Live seq 7 > W = 6 adds to the as-of-W count (P4)."}
      ]
    },
    {
      "id": "filtered-page-does-not-move-cursor",
      "title": "A Topic-filtered page holding Messages above the cursor extends the Topic view only: the cursor stays, no gap fill starts, the stream advances it",
      "covers": ["P1","C1","C2","C3"],
      "proposed": {"owner": ["#138"]},
      "never": [{"type":"fetch_history","page":"after"},{"type":"wait","purpose":"reorder_grace"}],
      "steps": [
        {"input":{"type":"session_start"},"effects":{"required":[{"type":"connect"}]}},
        {"input":{"type":"connection_ready"}},
        {"input":{"type":"watch","channel":"A"},"effects":{"required":[{"type":"fetch_history","channel":"A","page":"latest","as":"f0"}]}},
        {"input":{"type":"history_result","respond_to":"f0","messages":[{"from":1,"to":3}],"has_more":false},"effects":{"required":[{"type":"subscribe","channel":"A","after_seq":3,"as":"s0"}]}},
        {"input":{"type":"subscribed","channel":"A","caught_up_seq":3,"respond_to":"s0"},"observe":{"channels":{"A":{"state":"ready","cursor":3}}}},
        {"input":{"type":"open_topic","channel":"A","topic":"T"},"effects":{"required":[{"type":"fetch_history","channel":"A","topic":"T","as":"t0"}]}},
        {"input":{"type":"history_result","respond_to":"t0","messages":[{"seq":5,"topic":"T"},{"seq":7,"topic":"T"}],"has_more":false},"effects":{"forbidden":[{"type":"fetch_history"},{"type":"subscribe"}]},"observe":{"channels":{"A":{"state":"ready","cursor":3,"topics":{"T":{"visible":[5,7]}}}}},"note":"5 and 7 are committed but not yet streamed; a filtered page never counts toward contiguity."},
        {"input":{"type":"message","channel":"A","message":{"seq":4}},"observe":{"channels":{"A":{"cursor":4}}}},
        {"input":{"type":"message","channel":"A","message":{"seq":5,"topic":"T"}},"observe":{"channels":{"A":{"cursor":5}}}},
        {"input":{"type":"message","channel":"A","message":{"seq":6}}},
        {"input":{"type":"message","channel":"A","message":{"seq":7,"topic":"T"}},"observe":{"channels":{"A":{"cursor":7,"topics":{"T":{"visible":[5,7]}}}}},"note":"The streamed copies of 5 and 7 collapse with the page copies (C1)."}
      ]
    },
    {
      "id": "established-cursor-not-moved-by-page-anchor",
      "title": "A main-timeline page's W never moves an established cursor, and Messages at or below W never change the page's baseline count",
      "covers": ["P3","P4","C2"],
      "proposed": {"owner": ["#138"]},
      "never": [{"type":"subscribe","after_seq":9}],
      "steps": [
        {"input":{"type":"session_start"},"effects":{"required":[{"type":"connect"}]}},
        {"input":{"type":"connection_ready"}},
        {"input":{"type":"watch","channel":"A"},"effects":{"required":[{"type":"fetch_history","channel":"A","page":"latest","as":"f0"}]}},
        {"input":{"type":"history_result","respond_to":"f0","messages":[{"from":1,"to":5}],"has_more":false},"effects":{"required":[{"type":"subscribe","channel":"A","after_seq":5,"as":"s0"}]}},
        {"input":{"type":"subscribed","channel":"A","caught_up_seq":5,"respond_to":"s0"}},
        {"input":{"type":"message","channel":"A","message":{"seq":6}},"observe":{"channels":{"A":{"state":"ready","cursor":6}}}},
        {"input":{"type":"load_main_timeline","channel":"A"},"effects":{"required":[{"type":"fetch_main_timeline","channel":"A","as":"m0"}]}},
        {"input":{"type":"main_timeline_result","respond_to":"m0","as_of_seq":9,"items":[{"kind":"message","message":{"seq":6}},{"kind":"message","message":{"seq":8}},{"kind":"topic","topic":{"name":"T","last_seq":9,"message_count":2}}],"has_more":true},"effects":{"forbidden":[{"type":"subscribe"},{"type":"fetch_history"}]},"observe":{"channels":{"A":{"state":"ready","cursor":6,"main_timeline":[{"seq":1},{"seq":2},{"seq":3},{"seq":4},{"seq":5},{"seq":6},{"seq":8},{"topic":"T","position":9,"message_count":2}]}}},"note":"W = 9 is a page anchor only: 7..9 may still be on their way in the stream."},
        {"input":{"type":"message","channel":"A","message":{"seq":7,"topic":"T"}},"observe":{"channels":{"A":{"cursor":7}}}},
        {"input":{"type":"message","channel":"A","message":{"seq":8}}},
        {"input":{"type":"message","channel":"A","message":{"seq":9,"topic":"T"}},"observe":{"channels":{"A":{"cursor":9,"main_timeline":[{"seq":1},{"seq":2},{"seq":3},{"seq":4},{"seq":5},{"seq":6},{"seq":8},{"topic":"T","position":9,"message_count":2}]}}},"note":"7 and 9 are at or below W: already in the baseline count, so it stays 2."}
      ]
    },
    {
      "id": "posting-during-main-timeline-paging-loses-and-duplicates-no-topic",
      "title": "Posts during main-timeline paging (existing unpaged Topics, a new Topic, an already paged Topic) lose and duplicate no Topic, and merged counts are exact",
      "covers": ["P2","P3","P4","P5","C1","C2"],
      "proposed": {"owner": ["#138"], "note": "Server pages run in delivery/main-timeline-paging.json (#137); client merging remains proposed (#138). W = 10. As of W: 1 none, 2 T1, 3 T2, 4 none, 5 T3, 6 T1, 7 T2, 8 none, 9 T4, 10 T1. After W: 11 T2, 12 T5 (new), 13 T3, 14 T4, 15 none. Pages of 3 lines."},
      "steps": [
        {"input":{"type":"session_start"},"effects":{"required":[{"type":"connect"}]}},
        {"input":{"type":"connection_ready"}},
        {"input":{"type":"watch","channel":"A"},"effects":{"required":[{"type":"fetch_history","channel":"A","page":"latest","as":"f0"}]}},
        {"input":{"type":"history_result","respond_to":"f0","messages":[{"seq":6,"topic":"T1"},{"seq":7,"topic":"T2"},{"seq":8},{"seq":9,"topic":"T4"},{"seq":10,"topic":"T1"}],"has_more":true},"effects":{"required":[{"type":"subscribe","channel":"A","after_seq":10,"as":"s0"}]}},
        {"input":{"type":"subscribed","channel":"A","caught_up_seq":10,"respond_to":"s0"},"observe":{"channels":{"A":{"state":"ready","cursor":10,"main_timeline":[{"topic":"T2","position":7,"message_count":null},{"seq":8},{"topic":"T4","position":9,"message_count":null},{"topic":"T1","position":10,"message_count":null}]}}},"note":"Topics known only from Message records have no count yet (P4)."},
        {"input":{"type":"load_main_timeline","channel":"A"},"effects":{"required":[{"type":"fetch_main_timeline","channel":"A","as":"m0"}]}},
        {"input":{"type":"main_timeline_result","respond_to":"m0","as_of_seq":10,"items":[{"kind":"message","message":{"seq":8}},{"kind":"topic","topic":{"name":"T4","last_seq":9,"message_count":1}},{"kind":"topic","topic":{"name":"T1","last_seq":10,"message_count":3}}],"has_more":true},"observe":{"channels":{"A":{"cursor":10,"main_timeline":[{"topic":"T2","position":7,"message_count":null},{"seq":8},{"topic":"T4","position":9,"message_count":1},{"topic":"T1","position":10,"message_count":3}]}}}},
        {"input":{"type":"message","channel":"A","message":{"seq":11,"topic":"T2"}}},
        {"input":{"type":"message","channel":"A","message":{"seq":12,"topic":"T5"}}},
        {"input":{"type":"message","channel":"A","message":{"seq":13,"topic":"T3"}}},
        {"input":{"type":"message","channel":"A","message":{"seq":14,"topic":"T4"}}},
        {"input":{"type":"message","channel":"A","message":{"seq":15}},"observe":{"channels":{"A":{"cursor":15,"main_timeline":[{"seq":8},{"topic":"T1","position":10,"message_count":3},{"topic":"T2","position":11,"message_count":null},{"topic":"T5","position":12,"message_count":null},{"topic":"T3","position":13,"message_count":null},{"topic":"T4","position":14,"message_count":2},{"seq":15}]}}},"note":"T4 had a baseline (1 as of W) plus live 14; T2, T3 and T5 have none yet."},
        {"input":{"type":"load_main_timeline","channel":"A"},"effects":{"required":[{"type":"fetch_main_timeline","channel":"A","as_of_seq":10,"before_position":8,"as":"m1"}]},"note":"Continuation uses W and the W-based boundary, not positions moved by later activity."},
        {"input":{"type":"main_timeline_result","respond_to":"m1","as_of_seq":10,"items":[{"kind":"message","message":{"seq":4}},{"kind":"topic","topic":{"name":"T3","last_seq":5,"message_count":1}},{"kind":"topic","topic":{"name":"T2","last_seq":7,"message_count":2}}],"has_more":true},"effects":{"forbidden":[{"type":"subscribe"},{"type":"fetch_history"}]},"observe":{"channels":{"A":{"cursor":15,"main_timeline":[{"seq":4},{"seq":8},{"topic":"T1","position":10,"message_count":3},{"topic":"T2","position":11,"message_count":3},{"topic":"T5","position":12,"message_count":null},{"topic":"T3","position":13,"message_count":2},{"topic":"T4","position":14,"message_count":2},{"seq":15}]}}},"note":"The older page's T2 and T3 lines merge into the live lines: count = count_W + live seq > W, one line each."},
        {"input":{"type":"load_main_timeline","channel":"A"},"effects":{"required":[{"type":"fetch_main_timeline","channel":"A","as_of_seq":10,"before_position":4,"as":"m2"}]}},
        {"input":{"type":"main_timeline_result","respond_to":"m2","as_of_seq":10,"items":[{"kind":"message","message":{"seq":1}}],"has_more":false},"observe":{"channels":{"A":{"cursor":15,"main_timeline":[{"seq":1},{"seq":4},{"seq":8},{"topic":"T1","position":10,"message_count":3},{"topic":"T2","position":11,"message_count":3},{"topic":"T5","position":12,"message_count":null},{"topic":"T3","position":13,"message_count":2},{"topic":"T4","position":14,"message_count":2},{"seq":15}]}}},"note":"Every Topic with a Message <= W (T1-T4) appears once; T5 gets a count only from a later summary fetch."}
      ]
    }
  ]
}
