        {"input":{"type":"subscribed","channel":"A","caught_up_seq":100,"respond_to":"A_s0"},"observe":{"channels":{"A":{"state":"ready","cursor":100,"visible":[{"from":51,"to":100}]}}}},
        {"input":{"type":"message","channel":"A","seq":103,"kind":"create","message":{"created_seq":103}},"effects":{"required":[{"type":"wait","purpose":"reorder_grace","channel":"A","as":"A_t1"}],"forbidden":[{"type":"fetch_history","channel":"A"}]},"observe":{"channels":{"A":{"cursor":100,"visible":[{"from":51,"to":100},103]}}}},
        {"input":{"type":"message","channel":"A","seq":101,"kind":"create","message":{"created_seq":101}},"effects":{"forbidden":[{"type":"fetch_history","channel":"A"}]},"observe":{"channels":{"A":{"cursor":101,"visible":[{"from":51,"to":101},103]}}}},
        {"input":{"type":"message","channel":"A","seq":102,"kind":"create","message":{"created_seq":102}},"effects":{"forbidden":[{"type":"fetch_history","channel":"A"}]},"observe":{"channels":{"A":{"cursor":103,"visible":[{"from":51,"to":103}]}}}},
        {"input":{"type":"timer_elapsed","respond_to":"A_t1"},"effects":{"forbidden":[{"type":"fetch_history","channel":"A"}]}}
