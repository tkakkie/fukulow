        {"input":{"type":"connection_ready"},"effects":{"required":[{"type":"subscribe","channel":"A","after_seq":100,"as":"r_s"}]}},
        {"input":{"type":"message","channel":"A","seq":102,"kind":"create","message":{"created_seq":102}},"observe":{"channels":{"A":{"cursor":100}}}},
        {"input":{"type":"message","channel":"A","seq":103,"kind":"create","message":{"created_seq":103}},"observe":{"channels":{"A":{"cursor":100}}}},
        {"input":{"type":"subscribed","channel":"A","caught_up_seq":103,"respond_to":"r_s"},"effects":{"required":[{"type":"fetch_history","channel":"A","page":"after","seq":100,"as":"r_f","times":1}]},"observe":{"channels":{"A":{"cursor":100,"visible":[{"from":51,"to":100},102,103]}}},"note":"Hypothetical replay that skipped 101 (the server does not do this); the client must not trust it."},
        {"input":{"type":"events_result","respond_to":"r_f","events":[{"seq":101,"kind":"create","message":{"created_seq":101}},{"seq":102,"kind":"create","message":{"created_seq":102}},{"seq":103,"kind":"create","message":{"created_seq":103}}],"has_more":false},"effects":{"forbidden":[{"type":"fetch_history","channel":"A"}]},"observe":{"channels":{"A":{"cursor":103,"visible":[{"from":51,"to":103}]}}}}
      ]
