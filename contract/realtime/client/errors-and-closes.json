{
  "kind": "client",
  "scenarios": [
    {
      "id": "refused-subscription-channel-not-found-is-terminal",
      "title": "channel_not_found on subscribe makes the Channel unavailable; it is not a gap, never retried in a loop, not retried after a reconnect",
      "covers": ["C9"],
      "steps": [
        {"input":{"type":"session_start"},"effects":{"required":[{"type":"connect"}]}},
        {"input":{"type":"connection_ready"}},
        {"input":{"type":"watch","channel":"A"},"effects":{"required":[{"type":"fetch_history","channel":"A","page":"latest","as":"A_f0"}]}},
        {"input":{"type":"history_result","respond_to":"A_f0","messages":[{"from":51,"to":100}],"has_more":true},"effects":{"required":[{"type":"subscribe","channel":"A","after_seq":100,"as":"A_s0"}]}},
        {"input":{"type":"error_event","channel":"A","code":"channel_not_found"},"effects":{"forbidden":[{"type":"subscribe","channel":"A"},{"type":"fetch_history","channel":"A"},{"type":"wait"}]},"observe":{"channels":{"A":{"state":"unavailable"}}}},
        {"input":{"type":"socket_closed","code":1006},"effects":{"required":[{"type":"wait","purpose":"reconnect_backoff","as":"r_w"}]}},
        {"input":{"type":"timer_elapsed","respond_to":"r_w"},"effects":{"required":[{"type":"connect"}]}},
        {"input":{"type":"connection_ready"},"effects":{"forbidden":[{"type":"subscribe","channel":"A"},{"type":"fetch_history","channel":"A"}]},"observe":{"channels":{"A":{"state":"unavailable"}}}},
        {"input":{"type":"unwatch","channel":"A"}},
        {"input":{"type":"watch","channel":"A"},"effects":{"required":[{"any_of":[{"type":"fetch_history","channel":"A","page":"latest"},{"type":"subscribe","channel":"A"}]}]},"note":"The user selects the Channel again: only now may the client try again."}
      ]
    },
