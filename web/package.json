{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "node ../scripts/build-wasm.ts",
    "dev": "node ../scripts/build-wasm.ts --unless-ts && vite",
    "prebuild": "node ../scripts/build-wasm.ts --unless-ts",
    "build": "vite build",
    "preview": "vite preview",
    "precheck": "npm run wasm",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "pretest": "npm run wasm",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:compose": "playwright test -c playwright.compose.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.13.1"
  }
}
