{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "node ../scripts/build-wasm.ts",
    "dev": "node ../scripts/build-wasm.ts && vite",
    "prebuild": "node ../scripts/build-wasm.ts",
    "build": "vite build",
    "preview": "vite preview",
    "precheck": "npm run wasm",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.backup.json && tsc -p tsconfig.worker.json",
    "pretest": "npm run wasm",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:compose": "playwright test -c playwright.compose.config.ts",
    "e2e:component": "playwright test -c playwright.component.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "26.13.1"
  }
}
