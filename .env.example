# Replace this placeholder; use URL-safe characters because Compose builds DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Separate required app credential; use URL-safe characters (e.g. openssl rand -hex 32).
# Owner DATABASE_URL is used by cargo tests and `fukulow-server migrate [roles]`.
POSTGRES_APP_PASSWORD=
# For local tests/migrations against your own PostgreSQL instance (not read by Compose).
DATABASE_URL=postgres://fukulow:replace-with-a-random-local-password@127.0.0.1:5432/fukulow
# After `migrate roles` and `migrate`, run the server with the separate app URL:
# DATABASE_URL=postgres://fukulow_app:replace-with-your-app-password@127.0.0.1:5432/fukulow cargo run
FUKULOW_ADDR=127.0.0.1:8080
# Production Caddy: public DNS to this VPS, TCP 80/443 open, valid HTTPS required.
# nginx is HTTP-only: requires an external TLS terminator with HTTPS redirect,
# valid public certificate, HSTS and WebSocket support; restrict its HTTP ingress.
FUKULOW_DOMAIN=localhost
# Set true for HTTPS (including TLS proxies); false only for local HTTP.
# This also selects the CSP WebSocket scheme and default cookie WebSocket Origin scheme.
FUKULOW_COOKIE_SECURE=true
# WebSocket cookie auth defaults to the Host with https (http when COOKIE_SECURE=false).
# Optional explicit browser origin allowlist; forwarded headers are never trusted for Origin.
# FUKULOW_WS_ALLOWED_ORIGINS=https://chat.example.com,http://localhost:5173
# Required in every mode, independent of COOKIE_SECURE. Generate a random secret
# with `openssl rand -base64 32`. Never log it or commit the real value.
# Send it as setup_token in POST /api/v1/setup; GET setup status remains public.
FUKULOW_SETUP_TOKEN=
# Compose derives edge subnet <prefix>.0/29, gateway .1, proxy .2 and app .3;
# dynamic addresses are restricted to <prefix>.4/30.
# Change this one IPv4 prefix to move both the subnet and fixed proxy IP together.
# Only the proxy IP is trusted, never the gateway. Run only one proxy profile.
FUKULOW_EDGE_PREFIX=172.30.94
# Standalone/docker run only: configure BOTH to trust exact IPs or CIDRs (v4/v6).
# Compose sets these itself from EDGE_PREFIX; it does not use these overrides.
# FUKULOW_TRUSTED_PROXIES=192.0.2.2,2001:db8::/64
# FUKULOW_CLIENT_IP_HEADER=x-forwarded-for
# A single header field uses its rightmost comma-separated IP (Caddy/nginx append
# or overwrite it). Missing/invalid rightmost IP or repeated header fields use
# the socket peer. An untrusted peer's header is always ignored.
