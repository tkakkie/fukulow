# Replace this placeholder; use URL-safe characters because Compose builds DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# For running cargo locally against your own PostgreSQL instance (not read by Compose).
DATABASE_URL=postgres://fukulow:replace-with-a-random-local-password@127.0.0.1:5432/fukulow
FUKULOW_ADDR=127.0.0.1:8080
FUKULOW_DOMAIN=localhost
# Keep true behind HTTPS. Set false only for local plain-HTTP development.
FUKULOW_COOKIE_SECURE=true
# Optional: set a random setup token before exposing the server publicly.
# Send the same value as setup_token in POST /api/v1/setup.
# Leave unset to allow setup without a token; an explicitly empty value fails startup.
# FUKULOW_SETUP_TOKEN=replace-with-a-random-setup-token
