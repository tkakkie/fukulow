{
  "note": "Version inventory (#512). scripts/check-versions.ts checks each version against its file; .github/workflows/version-check.yml reports newer releases and support ends weekly. Rules: docs/workflow.md section 8.",
  "entries": [
    { "component": "Rust", "version": "1.100.0", "file": "rust-toolchain.toml", "pattern": "^channel = \"([^\"]+)\"$",
      "support": "latest only", "endoflife": "rust", "updates": "weekly-check", "class": "toolchain", "latest": { "endoflife": "rust" } },
    { "component": "Node.js", "version": "26.13.1", "file": ".node-version", "pattern": "^(\\S+)$",
      "support": "2029-04-30", "endoflife": "nodejs", "updates": "weekly-check", "class": "toolchain", "latest": { "endoflife": "nodejs", "lts": true } },
    { "component": "PostgreSQL", "version": "18.6", "file": "compose.yml", "pattern": "image: postgres:([^@\\s]+)",
      "support": "2030-11-14", "endoflife": "postgresql", "updates": "dependabot", "class": "manual-major" },
    { "component": "Debian runtime base", "version": "trixie", "file": "Dockerfile", "pattern": "^FROM debian:([a-z]+)-slim",
      "cycle": "13", "support": "2030-06-30", "endoflife": "debian", "updates": "manual", "class": "manual-major" },
    { "component": "Caddy", "version": "2.11.9", "file": "compose.yml", "pattern": "image: caddy:([^@\\s]+)",
      "support": "latest only", "endoflife": "caddy", "updates": "dependabot", "class": "patch-minor" },
    { "component": "nginx", "version": "1.31.8", "file": "compose.yml", "pattern": "image: nginx:([^@\\s]+)",
      "support": "latest only", "endoflife": "nginx", "updates": "dependabot", "class": "patch-minor" },
    { "component": "k6", "version": "1.8.2", "file": "Makefile", "pattern": "^K6_IMAGE := grafana/k6:(\\S+)$",
      "support": "latest only", "updates": "weekly-check", "class": "patch-minor", "latest": { "github": "grafana/k6" } },
    { "component": "wasm-bindgen-cli", "version": "0.2.130", "file": "client-core/Cargo.toml", "pattern": "wasm-bindgen = \\{ version = \"=([^\"]+)\"",
      "support": "latest only", "updates": "weekly-check", "class": "patch-minor", "latest": { "github": "wasm-bindgen/wasm-bindgen" } },
    { "component": "Playwright", "version": "1.65.0", "file": "web/package.json", "pattern": "\"@playwright/test\": \"([^\"]+)\"",
      "support": "latest only", "updates": "dependabot", "class": "patch-minor" },
    { "component": "axum", "version": "0.8.9", "file": "Cargo.lock", "pattern": "name = \"axum\"\\nversion = \"([^\"]+)\"",
      "support": "latest only", "updates": "dependabot", "class": "patch-minor" },
    { "component": "tokio", "version": "1.54.1", "file": "Cargo.lock", "pattern": "name = \"tokio\"\\nversion = \"([^\"]+)\"",
      "support": "latest only", "updates": "dependabot", "class": "patch-minor" },
    { "component": "sqlx", "version": "0.8.6", "file": "Cargo.lock", "pattern": "name = \"sqlx\"\\nversion = \"([^\"]+)\"",
      "support": "latest only", "updates": "dependabot", "class": "patch-minor" },
    { "component": "Svelte", "version": "5.57.3", "file": "web/package-lock.json", "pattern": "\"node_modules/svelte\": \\{\\n\\s+\"version\": \"([^\"]+)\"",
      "support": "latest only", "endoflife": "svelte", "updates": "dependabot", "class": "patch-minor" },
    { "component": "Vite", "version": "8.3.8", "file": "web/package-lock.json", "pattern": "\"node_modules/vite\": \\{\\n\\s+\"version\": \"([^\"]+)\"",
      "support": "latest only", "updates": "dependabot", "class": "patch-minor" },
    { "component": "TypeScript", "version": "6.0.3", "file": "web/package-lock.json", "pattern": "\"node_modules/typescript\": \\{\\n\\s+\"version\": \"([^\"]+)\"",
      "support": "latest only", "updates": "dependabot", "class": "patch-minor" }
  ]
}
